# Copy to .env and fill in to run chapters against the real OpenAI API.
# Without a key, every chapter runs against a built-in offline scripted model
# so you can watch the harness loop work without spending tokens.

OPENAI_API_KEY=
# Model id used by the chapters (a reasoning model, as Codex uses).
MODEL_ID=gpt-5-codex
# Optional: point at a compatible gateway / proxy.
# OPENAI_BASE_URL=https://your-gateway/v1
